<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pms.mapper.ProductionReportMapper">
    <resultMap id="BaseResultMap" type="com.pms.entity.ProductionReport">
        <id column="id" property="id"/>
        <result column="pond_id" property="pondId"/>
        <result column="report_type" property="reportType"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="title" property="title"/>
        <result column="status" property="status"/>
        <result column="data_snapshot" property="dataSnapshot"/>
        <result column="content" property="content"/>
        <result column="model_provider" property="modelProvider"/>
        <result column="model_name" property="modelName"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO production_report
        (pond_id, report_type, start_date, end_date, title, status, data_snapshot,
         content, model_provider, model_name, created_at, updated_at)
        VALUES
        (#{pondId}, #{reportType}, #{startDate}, #{endDate}, #{title}, #{status},
         #{dataSnapshot}, #{content}, #{modelProvider}, #{modelName}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM production_report WHERE id = #{id}
    </select>

    <select id="findPage" resultMap="BaseResultMap">
        SELECT * FROM production_report
        <where><if test="pondId != null">pond_id = #{pondId}</if></where>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM production_report
        <where><if test="pondId != null">pond_id = #{pondId}</if></where>
    </select>
</mapper>
