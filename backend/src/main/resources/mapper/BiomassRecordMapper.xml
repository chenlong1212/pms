<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pms.mapper.BiomassRecordMapper">

    <resultMap id="BaseResultMap" type="com.pms.entity.BiomassRecord">
        <id column="id" property="id"/>
        <result column="pond_id" property="pondId"/>
        <result column="record_date" property="recordDate"/>
        <result column="biomass_kg" property="biomassKg"/>
        <result column="fish_count" property="fishCount"/>
        <result column="avg_weight_kg" property="avgWeightKg"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findTrendData" resultMap="BaseResultMap">
        SELECT b.id, b.pond_id, b.record_date, b.biomass_kg, b.fish_count,
               a.avg_weight_kg, b.created_at
        FROM biomass_record b
        INNER JOIN avg_weight_record a
            ON b.pond_id = a.pond_id AND b.record_date = a.record_date
        WHERE b.pond_id = #{pondId}
          AND b.record_date &gt;= #{startDate}
          AND b.record_date &lt;= #{endDate}
        ORDER BY b.record_date ASC
    </select>

</mapper>
